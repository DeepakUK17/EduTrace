# ==========================================
# EduTrace Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit .env to source control
# ==========================================

# ---- Database (Neon PostgreSQL) ----
# Get from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/edutrace?sslmode=require"

# ---- Authentication ----
JWT_SECRET="change-this-to-a-random-64-char-string"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="change-this-to-another-random-64-char-string"

# ---- Encryption (APAAR identifier storage) ----
# Must be exactly 32 bytes (256-bit), base64 encoded
APAAR_ENCRYPTION_KEY="change-this-32-byte-base64-key-here-x"
# Must be at least 32 chars for HMAC matching token
APAAR_HMAC_SECRET="change-this-to-a-random-hmac-secret-string"

# ---- Server ----
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN="http://localhost:5173"

# ---- Integration Mode ----
# Set to SIMULATED for prototype. Only change to LIVE when you have authorized API credentials.
INTEGRATION_MODE=SIMULATED

# ---- External APIs (Leave blank unless you have authorized access) ----
# These require official approval from AICTE/APAAR/ABC before use
APAAR_API_URL=
APAAR_API_KEY=
AICTE_API_URL=
AICTE_API_KEY=

# ---- Demo Mode ----
# Set to false in production to disable demo seed accounts
ENABLE_DEMO_ACCOUNTS=true

# ---- Render (Production Backend URL) ----
# Set this to your Render service URL after deployment
API_BASE_URL=https://edutrace-api.onrender.com
